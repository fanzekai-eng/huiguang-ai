# ===== 环境变量模板（复制为 .env 后填写）=====

# ===== 数据库（Neon Postgres，https://neon.com 免费创建）=====
# pooled 连接（主机名带 -pooler 后缀）：应用运行时使用（PgBouncer 连接池）
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# direct 连接（主机名无 -pooler 后缀）：Prisma 迁移专用（迁移不能走池化连接）
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT 签名密钥（生成随机长字符串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
AUTH_SECRET="change-me-to-a-random-secret"

# ===== 绘图服务配置 =====
# 服务商：siliconflow（硅基流动）| zhipu（智谱，CogView-3-Flash 免费，推荐）
# 注意：2026-08 硅基流动已下架免费绘图模型，推荐使用智谱
IMAGE_PROVIDER="zhipu"
# 智谱 Key 在 https://open.bigmodel.cn 创建（硅基流动则在 https://cloud.siliconflow.cn）
IMAGE_API_KEY=""
# 以下一般不用改，需要时可覆盖默认服务地址/模型
# IMAGE_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
# IMAGE_MODEL="cogview-3-flash"
