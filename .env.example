# ===== 环境变量模板（复制为 .env 后填写）=====

# 数据库连接（本地开发用 SQLite；部署到 Vercel 时改为 Neon Postgres 连接串）
DATABASE_URL="file:./dev.db"

# JWT 签名密钥（部署时生成随机长字符串，可用 openssl rand -hex 32）
AUTH_SECRET="change-me-to-a-random-secret"

# ===== 绘图服务配置 =====
# 服务商：siliconflow（硅基流动，默认，FLUX.1-schnell 免费）| zhipu（智谱，CogView-3-Flash 免费）
IMAGE_PROVIDER="siliconflow"
# 在 https://cloud.siliconflow.cn 控制台创建 API Key（智谱则在 https://open.bigmodel.cn）
IMAGE_API_KEY=""
# 以下一般不用改，需要时可覆盖默认服务地址/模型
# IMAGE_BASE_URL="https://api.siliconflow.cn/v1"
# IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"
