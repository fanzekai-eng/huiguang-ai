// 数据库模型（本地开发用 SQLite；部署时切换 Postgres）
// 切换方式：provider 改为 "postgresql"，DATABASE_URL 指向 Neon 云库

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  phone        String       @unique
  credits      Int          @default(0)
  lastSignInAt String? // 最近签到日期 YYYY-MM-DD，null=从未签到
  createdAt    DateTime     @default(now())
  generations  Generation[]
}

model Generation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptAssembled String
  optionsJson     String
  subject         String
  status          String   @default("success") // success | failed
  mimeType        String   @default("image/png")
  imageBase64     String?
  size            String
  createdAt       DateTime @default(now())

  @@index([userId])
}
