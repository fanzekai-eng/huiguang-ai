// 数据库模型（Neon Postgres，项目 late-base-52351328）
// url = 应用运行时（pooled 连接，PgBouncer 池化）
// directUrl = Prisma 迁移专用（direct 连接，池化不支持迁移的会话级操作）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String       @id @default(cuid())
  phone        String       @unique
  credits      Int          @default(0)
  lastSignInAt String? // 最近签到日期 YYYY-MM-DD，null=从未签到
  createdAt    DateTime     @default(now())
  generations  Generation[]
}

model Generation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptAssembled String
  optionsJson     String
  subject         String
  status          String   @default("success") // success | failed
  mimeType        String   @default("image/png")
  imageBase64     String?
  size            String
  createdAt       DateTime @default(now())

  @@index([userId])
}
